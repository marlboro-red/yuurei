+//! Bounded overlapped output reader for self-created ConPTY pipes.
+//! One buffer is parsed while the other read is in flight. The stop event
+//! prevents a cancellation race between checking shutdown and issuing a read.
+const Self = @This();
+const std = @import("std");
+const windows = @import("../os/windows.zig");
+const Win32Error = std.os.windows.Win32Error;
+
+pub extern "kernel32" fn CreateEventW(?*windows.SECURITY_ATTRIBUTES, windows.BOOL, windows.BOOL, ?[*:0]const u16) callconv(.winapi) ?windows.HANDLE;
+pub extern "kernel32" fn SetEvent(windows.HANDLE) callconv(.winapi) windows.BOOL;
+extern "kernel32" fn ResetEvent(windows.HANDLE) callconv(.winapi) windows.BOOL;
+extern "kernel32" fn GetOverlappedResult(windows.HANDLE, *windows.OVERLAPPED, *windows.DWORD, windows.BOOL) callconv(.winapi) windows.BOOL;
+extern "kernel32" fn WaitForMultipleObjects(windows.DWORD, [*]const windows.HANDLE, windows.BOOL, windows.DWORD) callconv(.winapi) windows.DWORD;
+
+fd: windows.HANDLE,
+stop: windows.HANDLE,
+event: windows.HANDLE,
+overlapped: windows.OVERLAPPED = std.mem.zeroes(windows.OVERLAPPED),
+buffers: [2][128 * 1024]u8 = undefined,
+size: windows.DWORD,
+index: u1 = 0,
+started: bool = false,
+pending: bool = false,
+failure: ?Win32Error = null,
+
+pub const Result = union(enum) { data: []const u8, failure: Win32Error };
+
+pub fn init(fd: windows.HANDLE, stop: windows.HANDLE, size: usize) !Self {
+    const event = CreateEventW(null, windows.TRUE, windows.FALSE, null) orelse return error.CreateEventFailed;
+    return .{ .fd = fd, .stop = stop, .event = event, .size = @intCast(size) };
+}
+
+pub fn deinit(self: *Self) void {
+    // OVERLAPPED and its buffer must outlive cancellation completion.
+    if (self.pending) {
+        _ = windows.exp.kernel32.CancelIoEx(self.fd, &self.overlapped);
+        var ignored: windows.DWORD = 0;
+        _ = GetOverlappedResult(self.fd, &self.overlapped, &ignored, windows.TRUE);
+    }
+    _ = windows.exp.kernel32.CloseHandle(self.event);
+}
+
+fn issue(self: *Self) void {
+    if (windows.exp.kernel32.WaitForSingleObject(self.stop, 0) == 0) {
+        self.failure = .OPERATION_ABORTED;
+        return;
+    }
+    _ = ResetEvent(self.event);
+    self.overlapped = std.mem.zeroes(windows.OVERLAPPED);
+    self.overlapped.hEvent = self.event;
+    self.pending = true;
+    if (windows.exp.kernel32.ReadFile(self.fd, &self.buffers[self.index], self.size, null, &self.overlapped) == windows.FALSE) {
+        const err = windows.GetLastError();
+        if (err != .IO_PENDING) {
+            self.pending = false;
+            self.failure = err;
+        }
+    }
+}
+
+pub fn next(self: *Self) Result {
+    if (!self.started) {
+        self.started = true;
+        self.issue();
+    }
+    if (self.failure) |err| return .{ .failure = err };
+    const handles = [_]windows.HANDLE{ self.stop, self.event };
+    switch (WaitForMultipleObjects(handles.len, &handles, windows.FALSE, windows.INFINITE)) {
+        0 => return .{ .failure = .OPERATION_ABORTED },
+        1 => {},
+        else => return .{ .failure = windows.GetLastError() },
+    }
+    var n: windows.DWORD = 0;
+    if (GetOverlappedResult(self.fd, &self.overlapped, &n, windows.FALSE) == windows.FALSE) {
+        self.pending = false;
+        return .{ .failure = windows.GetLastError() };
+    }
+    self.pending = false;
+    const result = self.buffers[self.index][0..n];
+    self.index ^= 1;
+    self.issue();
+    return .{ .data = result };
+}
